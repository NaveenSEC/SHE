{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SHE: run spec example (emulated)",
      "type": "debugpy",
      "request": "launch",
      "module": "she_memory_update",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "SHE: print messages for a real ECU",
      "type": "debugpy",
      "request": "launch",
      "module": "she_memory_update",
      "args": ["--no-emulate"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "SHE: debug tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["--no-cov", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
