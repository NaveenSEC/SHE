{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Create venv and install",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install -e '.[dev]'",
      "windows": { "command": "py -m venv .venv; .venv\\Scripts\\pip install -e '.[dev]'" },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "python -m pytest",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
